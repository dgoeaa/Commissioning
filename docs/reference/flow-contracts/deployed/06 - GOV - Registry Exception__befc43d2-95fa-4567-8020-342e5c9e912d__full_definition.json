                        "parameters/headers": {
                          "Accept": "application/json;odata=nometadata",
                          "Content-Type": "application/json;odata=nometadata",
                          "IF-MATCH": "*",
                          "X-HTTP-Method": "MERGE"
                        },
                        "parameters/body": "@setProperty(setProperty(setProperty(json('{}'),'Status','Acknowledged'),'AssignedToEmail',if(empty(trim(string(item()?['AssignedToEmail']))),'dgsRegistry@nitda.gov.ng',trim(string(item()?['AssignedToEmail'])))),'DiagnosticJson',string(setProperty(setProperty(setProperty(json('{}'),'NotificationSentUtc',utcNow()),'NotificationRunId',workflow()?['run']?['name']),'PreviousDiagnostic',coalesce(item()?['DiagnosticJson'],''))))"
                      },
                      "host": {
