                          "parameters": {
                            "dataset": "https://nitdanigeria.sharepoint.com/sites/NEDMS",
                            "table": "NITDA_Portal_RateLimits",
                            "id": "@first(outputs('Get_Rate_Limit_Verify_Source')?['body/value']?['ID'])",
                            "item/RequestCount": "@outputs('Compose_RL_Verify_Source_New_Count')",
                            "item/WindowStartUtc": "@if(outputs('Compose_RL_Verify_Source_Window_Expired'), utcNow(), first(outputs('Get_Rate_Limit_Verify_Source')?['body/value']?['WindowStartUtc']))",
                            "item/UpdatedAtUtc": "@utcNow()"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "operationId": "PatchItem",
                            "connectionName": "shared_sharepointonline"
                          }
                        },
                        "runAfter": {},
                        "metadata": {
                          "operationMetadataId": "ebe95dbc-c3bf-49ec-a9d8-d17d63a56d77"
                        }
                      }
                    },
                    "else": {
                      "actions": {
                        "Create_Rate_Limit_Verify_Source": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "dataset": "https://nitdanigeria.sharepoint.com/sites/NEDMS",
                              "table": "NITDA_Portal_RateLimits",
                              "item/Title": "@concat('VERIFY_IP:', outputs('Compose_Source_Ip'))",
                              "item/WindowStartUtc": "@utcNow()",
                              "item/RequestCount": 1,
                              "item/UpdatedAtUtc": "@utcNow()"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "operationId": "PostItem",
                              "connectionName": "shared_sharepointonline"
                            }
                          },
                          "runAfter": {},
                          "metadata": {
                            "operationMetadataId": "6cb7e2cc-787f-4276-963d-a16c8c69139c"
                          }
                        }
                      }
                    },
                    "runAfter": {},
