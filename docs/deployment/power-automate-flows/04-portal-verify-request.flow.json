                    "runAfter": {
                      "Compose_RL_Verify_Email_Exists": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "13faaff1-552d-44e1-b960-b9fbfa0a86f0"
                    }
                  },
                  "Compose_RL_Verify_Email_Effective_Count": {
                    "type": "Compose",
                    "inputs": "@if(outputs('Compose_RL_Verify_Email_Window_Expired'), 0, if(outputs('Compose_RL_Verify_Email_Exists'), first(outputs('Get_Rate_Limit_Verify_Email')?['body/value']?['RequestCount']), 0))",
                    "runAfter": {
                      "Compose_RL_Verify_Email_Window_Expired": [
                        "Succeeded"
