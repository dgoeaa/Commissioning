        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "title": "Portal Verify Request",
            "description": "Ask the portal identity flows to mail a one-time verification code to an address.",
            "properties": {
              "email": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "email",
                "description": "The address to verify."
              }
            },
            "required": [],
            "additionalProperties": true
          }
        }
      }
    },
    "actions": {
      "Scope_Verify_Request_Main": {
        "type": "Scope",
        "actions": {
          "Compose_Source_Ip": {
            "type": "Compose",
            "inputs": "@trim(first(split(coalesce(triggerOutputs()?['headers']?['X-Forwarded-For'], triggerOutputs()?['headers']?['X-Azure-ClientIP'], 'unknown'), ',')))",
            "runAfter": {},
            "metadata": {
              "operationMetadataId": "c3db0964-dd05-4858-a3a4-f2a46b5caed0"
            }
          },
          "Compose_Email": {
            "type": "Compose",
            "inputs": "@toLower(trim(coalesce(triggerBody()?['email'], '')))",
            "runAfter": {
              "Compose_Source_Ip": [
                "Succeeded"
              ]
            },
            "metadata": {
              "operationMetadataId": "88cf1280-35fa-43d6-92c1-6cede06df6a2"
            }
          },
          "Condition_Validate_Email": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@and(contains(outputs('Compose_Email'), '@'), equals(indexOf(outputs('Compose_Email'), '@'), lastIndexOf(outputs('Compose_Email'), '@')), greater(indexOf(outputs('Compose_Email'), '@'), 0), less(indexOf(outputs('Compose_Email'), '@'), sub(length(outputs('Compose_Email')), 3)), contains(substring(outputs('Compose_Email'), add(indexOf(outputs('Compose_Email'), '@'), 1)), '.'), not(contains(outputs('Compose_Email'), ' ')))",
                    true
                  ]
                }
              ]
            },
            "actions": {
              "Get_Rate_Limit_Verify_Source": {
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "https://nitdanigeria.sharepoint.com/sites/NEDMS",
                    "table": "NITDA_Portal_RateLimits",
                    "$filter": "Title eq '@{replace(concat('VERIFY_IP:', outputs('Compose_Source_Ip')), '''', '''''')}'",
                    "$top": 1
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "operationId": "GetItems",
                    "connectionName": "shared_sharepointonline"
                  }
                },
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "9b3516b6-7399-48d8-8167-25347115f27d"
                }
              },
              "Compose_RL_Verify_Source_Exists": {
                "type": "Compose",
                "inputs": "@greater(length(outputs('Get_Rate_Limit_Verify_Source')?['body/value']), 0)",
                "runAfter": {
                  "Get_Rate_Limit_Verify_Source": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "1a2797e4-da98-4c98-b8c0-7f92aa6c99d8"
                }
              },
              "Compose_RL_Verify_Source_Window_Expired": {
                "type": "Compose",
                "inputs": "@if(outputs('Compose_RL_Verify_Source_Exists'), greater(sub(ticks(utcNow()), ticks(first(outputs('Get_Rate_Limit_Verify_Source')?['body/value']?['WindowStartUtc']))), 6000000000), true)",
                "runAfter": {
                  "Compose_RL_Verify_Source_Exists": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "03de7930-09a7-4582-9df0-274e8833cb0e"
                }
              },
              "Compose_RL_Verify_Source_Effective_Count": {
                "type": "Compose",
                "inputs": "@if(outputs('Compose_RL_Verify_Source_Window_Expired'), 0, if(outputs('Compose_RL_Verify_Source_Exists'), first(outputs('Get_Rate_Limit_Verify_Source')?['body/value']?['RequestCount']), 0))",
                "runAfter": {
                  "Compose_RL_Verify_Source_Window_Expired": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "5c0f5542-e412-4bf6-8641-74ae714c5e3b"
                }
              },
              "Compose_RL_Verify_Source_New_Count": {
                "type": "Compose",
                "inputs": "@add(outputs('Compose_RL_Verify_Source_Effective_Count'), 1)",
                "runAfter": {
                  "Compose_RL_Verify_Source_Effective_Count": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "d3fa5a50-316f-4cb6-bf26-debbcdb35bee"
                }
              },
              "Condition_RL_Verify_Source_Allowed": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@less(outputs('Compose_RL_Verify_Source_Effective_Count'), 10)",
                        true
                      ]
                    }
                  ]
                },
                "actions": {
                  "Condition_RL_Verify_Source_Bucket_Exists": {
                    "type": "If",
                    "expression": {
                      "and": [
                        {
                          "equals": [
                            "@outputs('Compose_RL_Verify_Source_Exists')",
                            true
                          ]
