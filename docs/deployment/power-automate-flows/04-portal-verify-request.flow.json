                        "actions": {
                          "Update_Rate_Limit_Verify_Email": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "parameters": {
                                "dataset": "https://nitdanigeria.sharepoint.com/sites/NEDMS",
                                "table": "NITDA_Portal_RateLimits",
                                "id": "@first(outputs('Get_Rate_Limit_Verify_Email')?['body/value']?['ID'])",
                                "item/RequestCount": "@outputs('Compose_RL_Verify_Email_New_Count')",
                                "item/WindowStartUtc": "@if(outputs('Compose_RL_Verify_Email_Window_Expired'), utcNow(), first(outputs('Get_Rate_Limit_Verify_Email')?['body/value']?['WindowStartUtc']))",
                                "item/UpdatedAtUtc": "@utcNow()"
                              },
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "operationId": "PatchItem",
                                "connectionName": "shared_sharepointonline"
                              }
                            },
                            "runAfter": {},
                            "metadata": {
                              "operationMetadataId": "7c25e1f9-4e4a-470d-8555-3a1e21e0ec44"
                            }
