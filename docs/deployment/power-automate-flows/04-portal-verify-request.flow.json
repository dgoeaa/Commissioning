                    "metadata": {
                      "operationMetadataId": "fb856eaa-8d12-47d5-a977-9d769220009d"
                    }
                  },
                  "Condition_RL_Verify_Email_Allowed": {
                    "type": "If",
                    "expression": {
                      "and": [
                        {
                          "equals": [
                            "@less(outputs('Compose_RL_Verify_Email_Effective_Count'), 3)",
                            true
                          ]
                        }
                      ]
                    },
                    "actions": {
                      "Condition_RL_Verify_Email_Bucket_Exists": {
                        "type": "If",
                        "expression": {
                          "and": [
