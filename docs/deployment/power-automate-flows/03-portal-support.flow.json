        },
        "connection": {
          "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline/connections/4b7f2a9e6c1d4f3e9a8b5c2d7e1f6a3b"
        },
        "connectionName": "4b7f2a9e6c1d4f3e9a8b5c2d7e1f6a3b"
      },
      "referenceKey": "shared_sharepointonline"
    },
    "Create_Rate_Limit_Support": {
      "connectionReference": {
        "api": {
          "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "connection": {
          "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline/connections/4b7f2a9e6c1d4f3e9a8b5c2d7e1f6a3b"
        },
        "connectionName": "4b7f2a9e6c1d4f3e9a8b5c2d7e1f6a3b"
      },
      "referenceKey": "shared_sharepointonline"
    },
    "Create_Support_Case": {
      "connectionReference": {
        "api": {
          "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "connection": {
          "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline/connections/4b7f2a9e6c1d4f3e9a8b5c2d7e1f6a3b"
        },
        "connectionName": "4b7f2a9e6c1d4f3e9a8b5c2d7e1f6a3b"
      },
      "referenceKey": "shared_sharepointonline"
    }
  },
  "staticResults": {}
}
