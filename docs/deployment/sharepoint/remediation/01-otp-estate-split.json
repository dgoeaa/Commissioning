        "$filter": "Email eq '@{toLower(trim(coalesce(triggerBody()?['email'],'')))}' and Consumed eq 0",
        "$orderby": "Created desc",
        "$top": 1
      },
      "alsoFixes": "The deployed filter matches on OTP_Code alone, so a code is accepted for whichever address minted it last rather than for the address presenting it. Filtering by Email and comparing the code inside the flow binds the two."
    },
