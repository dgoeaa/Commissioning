  "newActionsRequired": [
    {
      "name": "Increment_Attempts",
      "where": "Scope_Global/Switch/case:Case_Verify/Condition/else/Condition_1 - on the ELSE branch, where the presented code does not match",
      "type": "OpenApiConnection",
      "operationId": "PatchItem",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "PatchItem"
        },
        "parameters": {
          "dataset": "https://nitdanigeria.sharepoint.com/sites/Global_Digital_Documents_Centre",
          "table": "3f85213c-1fdc-4be0-8c0c-e28aa77fbe56",
          "id": "@outputs('Get_item_OTP_Record')?['body/ID']",
          "item/Attempts": "@add(coalesce(outputs('Get_item_OTP_Record')?['body/Attempts'],0),1)"
        }
      },
      "why": "Without a counter there is no cap, and a six-digit code with no cap is guessable by a script in under a minute. Consume the code once Attempts reaches 5.",
      "flow": "Portal_Verify_Confirm",
      "place": {
        "parent": "Scope_Global/Switch/case:Case_Verify/Condition/else/Condition_1/Condition_Code_Matches/else",
        "first": true
      }
    },
    {
      "name": "Consume_Expired_Challenge",
      "where": "Scope_Global/Switch/case:Case_Verify/Condition/else - on the branch taken when Expires_At is in the past",
      "type": "OpenApiConnection",
      "operationId": "PatchItem",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "PatchItem"
        },
        "parameters": {
          "dataset": "https://nitdanigeria.sharepoint.com/sites/Global_Digital_Documents_Centre",
          "table": "3f85213c-1fdc-4be0-8c0c-e28aa77fbe56",
          "id": "@outputs('Get_item_OTP_Record')?['body/ID']",
          "item/Consumed": true
        }
      },
      "why": "An expired code that stays unconsumed keeps matching the $filter and is returned again on the next attempt.",
      "flow": "Portal_Verify_Confirm",
      "place": {
        "parent": "Scope_Global/Switch/case:Case_Verify/Condition/else/Condition_1/else",
        "after": "Append_to_string_variable__OTP_Invalid_or_Expired"
      }
    },
