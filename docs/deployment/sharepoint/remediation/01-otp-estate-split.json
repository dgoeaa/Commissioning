        "id": "@first(outputs('Get_items')?['body/value'])?['ID']",
        "item/Consumed": true
      },
      "alsoFixes": "The deployed expression is first(outputs('Get_items')?['body/value']?['ID']), which indexes the ID of the array rather than taking the ID of the first item. Corrected here."
    },
    "Portal_Verify_Confirm / Get_items_OTP_Verify": {
      "path": "Scope_Global/Switch/case:Case_Verify/Get_items_OTP_Verify",
      "replaceParametersWith": {
        "dataset": "https://nitdanigeria.sharepoint.com/sites/Global_Digital_Documents_Centre",
