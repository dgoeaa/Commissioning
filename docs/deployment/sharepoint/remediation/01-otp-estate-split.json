    "list": "Portal OTP Codes",
    "site": "Global_Digital_Documents_Centre"
  },
  "columnMapping": [
    {
      "from": "Title",
      "to": "Title",
      "note": "Native column. Holds the lower-cased email, unchanged."
    },
    {
      "from": "OTP_Code",
      "to": "OTP_Code",
      "note": "Same name, already live on the target. No change to the expression."
    },
    {
      "from": "Expires_At",
      "to": "Expires_At",
      "note": "Same name, already live on the target. No change to the expression."
    },
    {
      "from": "Is_Verified",
      "to": "Consumed",
      "note": "RENAMED. Every item/Is_Verified becomes item/Consumed, and every $filter 'Is_Verified eq 0' becomes 'Consumed eq 0'."
    },
    {
      "from": null,
      "to": "Email",
      "note": "NEW, indexed. Set it to the same value as Title. The index is what keeps the $filter correct past the 5,000-item view threshold rather than merely faster below it."
    },
    {
      "from": null,
      "to": "Attempts",
      "note": "NEW. Initialise to 0 on mint; increment on every wrong code. Without it there is no cap and a code can be guessed without limit."
    },
    {
      "from": null,
      "to": "SourceIp",
      "note": "NEW. The caller's address, for rate limiting and forensics."
    },
    {
      "from": null,
      "to": "CreatedAtUtc",
      "note": "NEW. utcNow() at mint."
    }
  ],
  "actions": {
