      "path": "Scope_Global/Switch/case:Case_Generate/Create_item_OTP_Record",
      "replaceParametersWith": {
        "dataset": "https://nitdanigeria.sharepoint.com/sites/Global_Digital_Documents_Centre",
        "table": "3f85213c-1fdc-4be0-8c0c-e28aa77fbe56",
        "item/Title": "@toLower(trim(coalesce(triggerBody()?['email'],'')))",
