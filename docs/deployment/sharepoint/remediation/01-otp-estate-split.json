      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "PatchItem"
        },
        "parameters": {
          "dataset": "https://nitdanigeria.sharepoint.com/sites/Global_Digital_Documents_Centre",
          "table": "d6b97198-489c-4bd7-8647-1133c55efdf9",
          "id": "@first(outputs('Get_Rate_Limit_Verify_Source')?['body/value'])?['ID']",
          "item/RequestCount": "@if(greater(ticks(coalesce(first(outputs('Get_Rate_Limit_Verify_Source')?['body/value'])?['WindowStartUtc'],'1900-01-01T00:00:00Z')), ticks(addHours(utcNow(),-1))), add(coalesce(first(outputs('Get_Rate_Limit_Verify_Source')?['body/value'])?['RequestCount'],0),1), 1)",
          "item/UpdatedAtUtc": "@utcNow()",
